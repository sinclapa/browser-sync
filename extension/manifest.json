{
  "manifest_version": 3,
  "name": "BrowserSync",
  "version": "0.1.0",
  "description": "Keeps bookmarks in sync with another Chromium browser on this PC via a local BrowserSync host.",
  "permissions": ["bookmarks", "storage", "alarms"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "key": ""
}
